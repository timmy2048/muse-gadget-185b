# Copy to sdkconfig.wg.local (gitignored) and fill keys. Do not commit real keys.
# Board ships with endpoint UDP 51820 (ChinaNet-friendly). VPS still listens on
# 33535 for phone clients and REDIRECTs 51820→33535; do not remove 33535 / x-ui.
CONFIG_MUSE_WG_ENABLE=y
CONFIG_MUSE_WG_PRIVATE_KEY="YOUR_INTERFACE_PRIVATE_KEY_BASE64"
CONFIG_MUSE_WG_PEER_PUBLIC_KEY="YOUR_PEER_PUBLIC_KEY_BASE64"
CONFIG_MUSE_WG_ADDRESS="10.0.0.2"
CONFIG_MUSE_WG_NETMASK="255.255.255.255"
CONFIG_MUSE_WG_ENDPOINT="YOUR_ENDPOINT_HOST"
CONFIG_MUSE_WG_ENDPOINT_PORT=51820
CONFIG_MUSE_WG_KEEPALIVE=25
CONFIG_MUSE_WG_DNS="1.1.1.1"
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_WIREGUARD_MAX_SRC_IPS=4
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
