+bool muse_ota_is_enabled(void)
+{
+    return ota_is_enabled();
+}
+
+typedef struct {
+    muse_ota_apply_cb_t cb;
+    void *user;
+} muse_ota_bridge_t;
+
+static void muse_ota_bridge_cb(const ota_event_t *ev, void *user)
+{
+    muse_ota_bridge_t *b = user;
+    if (!b) {
+        return;
+    }
+    if (b->cb && ev) {
+        muse_ota_apply_event_t out = {
+            .result = ev->result == OTA_RESULT_APPLIED ? MUSE_OTA_APPLIED
+                      : (ev->result == OTA_RESULT_SKIPPED ? MUSE_OTA_SKIPPED : MUSE_OTA_FAILED),
+            .detail = ev->detail,
+            .new_version = ev->new_version,
+            .running_version = ev->running_version,
+        };
+        b->cb(&out, b->user);
+    }
+    free(b);
+}
+
+void muse_ota_apply(const char *url, bool force, muse_ota_apply_cb_t cb, void *user)
+{
+    muse_ota_bridge_t *b = NULL;
+    if (cb) {
+        b = calloc(1, sizeof(*b));
+        if (b) {
+            b->cb = cb;
+            b->user = user;
+        }
+    }
+    ota_start(url, force, b ? muse_ota_bridge_cb : NULL, b);
+    if (cb && !b) {
+        muse_ota_apply_event_t ev = { .result = MUSE_OTA_FAILED, .detail = "out of memory" };
+        cb(&ev, user);
+    }
+}
