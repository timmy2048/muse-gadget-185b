+    config MUSE_SCREEN_OFF_KEEP_LINK
+        bool "Keep Wi-Fi and Muse's session up while the screen is off"
+        depends on MUSE_ENABLED
+        default y if MUSE_BOARD_WAVESHARE_S3_185B
+        default n
+        help
+            Screen off (sleep timeout) only darkens and pauses the display.
+            Wi-Fi never naps (no disconnect after two minutes low power) and
+            rests at most in light modem sleep (WIFI_PS_MIN_MODEM), so the
+            tunnel and Muse's control session stay connected and waking needs
+            no reconnect. Costs more battery while dark.
+
 endmenu
