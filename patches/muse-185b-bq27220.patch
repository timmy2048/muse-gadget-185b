+        .dev_addr_length = I2C_ADDR_BIT_LEN_7,
+        .device_address = BQ_ADDR,
+        .scl_speed_hz = 100000,
+    };
+    if (i2c_master_probe(s_i2c, BQ_ADDR, 100) != ESP_OK ||
+        i2c_master_bus_add_device(s_i2c, &gauge_cfg, &s_gauge) != ESP_OK) {
+        ESP_LOGW(TAG, "no BQ27220: battery unavailable");
+        s_gauge = NULL;
+    } else {
