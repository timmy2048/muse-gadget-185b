+static esp_err_t tts_http_on_data(esp_http_client_event_t *evt)
+{
+    if (evt->event_id != HTTP_EVENT_ON_DATA || !evt->data || evt->data_len <= 0) {
+        return ESP_OK;
+    }
+    tts_data(static_cast<const uint8_t *>(evt->data), (size_t)evt->data_len);
+    return ESP_OK;
