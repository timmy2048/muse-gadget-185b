+static void tick_update(void)
+{
+    if (s_upd_applying) {
+        int pct = muse_ota_progress_percent();
+        if (pct < 0) {
+            pct = 0;
+        }
+        if (pct != s_upd_last_pct) {
+            s_upd_last_pct = pct;
+            if (s_upd_bar) {
+                lv_bar_set_value(s_upd_bar, pct, LV_ANIM_ON);
+            }
+            if (s_upd_pct) {
+                char buf[16];
+                snprintf(buf, sizeof(buf), "%d%%", pct);
+                set_text(s_upd_pct, buf);
+            }
+            if (s_upd_status) {
+                char msg[64];
+                if (pct >= 100) {
+                    snprintf(msg, sizeof(msg), "姝ｅ湪鏍￠獙骞跺啓鍏モ€?);
+                } else if (pct >= 10) {
+                    snprintf(msg, sizeof(msg), "姝ｅ湪涓嬭浇 %d%%锛岃鍕挎柇鐢?, pct);
+                } else {
+                    snprintf(msg, sizeof(msg), "姝ｅ湪涓嬭浇鍗囩骇锛岃鍕挎柇鐢碘€?);
+                }
+                set_text_cjk(s_upd_status, msg);
+            }
+            muse_state_set_progress(pct / 100.0f);
+        }
+        return;
+    }
+    muse_ota_check_info_t info;
+    muse_ota_check_get(&info);
+    if (info.state == s_upd_shown) {
+        return;
+    }
+    s_upd_shown = info.state;
+    char detail[192];
+    detail[0] = '\0';
+    switch (info.state) {
+    case MUSE_OTA_CHECK_IDLE:
+        set_text_cjk(s_upd_status, "鐐逛笅鏂规鏌ユ湇鍔″櫒鍥轰欢鐗堟湰");
+        snprintf(detail, sizeof(detail), "褰撳墠 %s", info.running[0] ? info.running : "?");
+        lv_obj_add_flag(s_upd_confirm_btn, LV_OBJ_FLAG_HIDDEN);
+        break;
+    case MUSE_OTA_CHECK_BUSY:
+        set_text_cjk(s_upd_status, "姝ｅ湪妫€鏌モ€?);
+        snprintf(detail, sizeof(detail), "褰撳墠 %s", info.running);
+        lv_obj_add_flag(s_upd_confirm_btn, LV_OBJ_FLAG_HIDDEN);
+        break;
+    case MUSE_OTA_CHECK_LATEST:
+        set_text_cjk(s_upd_status, "宸叉槸鏈€鏂?);
+        snprintf(detail, sizeof(detail), "褰撳墠 %s", info.running);
+        lv_obj_add_flag(s_upd_confirm_btn, LV_OBJ_FLAG_HIDDEN);
+        break;
+    case MUSE_OTA_CHECK_UPDATE:
+        {
+            char msg[128];
+            snprintf(msg, sizeof(msg), "鍙戠幇鏂扮増鏈?%.40s锛岀‘璁ゅ崌绾э紵", info.remote);
+            set_text_cjk(s_upd_status, msg);
+            if (info.notes[0]) {
+                snprintf(detail, sizeof(detail), "%s -> %s\n%.80s", info.running, info.remote, info.notes);
+            } else if (info.size > 0) {
+                snprintf(detail, sizeof(detail), "%s -> %s (%lld KB)", info.running, info.remote,
+                         (long long)(info.size / 1024));
+            } else {
+                snprintf(detail, sizeof(detail), "%s -> %s", info.running, info.remote);
+            }
+            set_text_cjk(s_upd_confirm_lbl, "纭鍗囩骇");
+            lv_obj_remove_flag(s_upd_confirm_btn, LV_OBJ_FLAG_HIDDEN);
+        }
+        break;
+    case MUSE_OTA_CHECK_ERROR:
+    default:
+        {
+            char msg[128];
+            snprintf(msg, sizeof(msg), "妫€鏌ュけ璐ワ細%.80s", info.error[0] ? info.error : "?");
+            set_text_cjk(s_upd_status, msg);
+            snprintf(detail, sizeof(detail), "褰撳墠 %s", info.running);
+            lv_obj_add_flag(s_upd_confirm_btn, LV_OBJ_FLAG_HIDDEN);
+        }
+        break;
+    }
+    set_text_cjk(s_upd_detail, detail);
+}
