+    (void)user;
+    s_upd_applying = false;
+    s_upd_last_pct = -1;
+    muse_state_set_progress(0);
+    if (s_upd_bar) {
+        lv_obj_add_flag(s_upd_bar, LV_OBJ_FLAG_HIDDEN);
+    }
+    if (s_upd_pct) {
+        lv_obj_add_flag(s_upd_pct, LV_OBJ_FLAG_HIDDEN);
+    }
+    if (!ev) {
+        return;
+    }
+    if (ev->result == MUSE_OTA_APPLIED) {
+        if (s_upd_status) {
+            set_text_cjk(s_upd_status, "鍗囩骇鎴愬姛锛屾鍦ㄩ噸鍚€?);
+        }
+        muse_state_set_caption("OTA OK, rebooting");
+    } else if (ev->result == MUSE_OTA_SKIPPED) {
+        if (s_upd_status) {
+            set_text_cjk(s_upd_status, "宸茶烦杩囷紙鐗堟湰鏈洿鏂帮級");
+        }
+    } else {
+        char buf[128];
+        snprintf(buf, sizeof(buf), "鍗囩骇澶辫触锛?.80s", ev->detail ? ev->detail : "?");
+        if (s_upd_status) {
+            set_text_cjk(s_upd_status, buf);
+        }
+        muse_state_set_caption("OTA failed");
+    }
+    s_upd_shown = (muse_ota_check_state_t)-1;
+}
+
